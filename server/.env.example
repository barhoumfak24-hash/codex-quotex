# Staff mailbox OAuth. Provider client secrets and token encryption stay
# server-side only; never prefix these values with VITE_.
MAILBOX_OAUTH_ENABLED="false"
# Local Express dev can use http://localhost:4000.
# Vercel production must include the function mount, for example:
# https://quotexinsurance.com/api/app
MAILBOX_OAUTH_PUBLIC_API_ORIGIN="http://localhost:4000"
MAILBOX_TOKEN_ENCRYPTION_KEY=""
MAILBOX_TOKEN_KEY_REF="env:MAILBOX_TOKEN_ENCRYPTION_KEY"
GOOGLE_MAILBOX_CLIENT_ID=""
GOOGLE_MAILBOX_CLIENT_SECRET=""
GOOGLE_MAILBOX_REDIRECT_URI=""
GOOGLE_MAILBOX_SCOPES="openid,email,profile,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.readonly"
MICROSOFT_MAILBOX_CLIENT_ID=""
MICROSOFT_MAILBOX_CLIENT_SECRET=""
MICROSOFT_MAILBOX_TENANT="organizations"
MICROSOFT_MAILBOX_REDIRECT_URI=""
