PORT=4000
FRONTEND_ORIGIN="http://localhost:5174"

# Supabase backend state sync.
# Run ../docs/supabase-state-sync.sql in Supabase SQL Editor first.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STATE_TABLE="quotex_app_state"
SUPABASE_STATE_SYNC_TOKEN=""

# AI provider, server side only.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"
OPENAI_FALLBACK_MODELS="gpt-5.4,gpt-5.4-mini"
OPENAI_REASONING_EFFORT="high"
AI_REQUEST_TIMEOUT_MS="60000"
GOOGLE_GEOCODING_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Carrier quote and carrier bind / issue bridges.
# Keep live bind disabled until each carrier/rater has approved the producer
# credentials and endpoint for actual policy issuance.
EZLYNX_ACCOUNT_USERNAME=""
EZLYNX_ENABLE_LIVE_QAS="false"
EZLYNX_ENABLE_LIVE_BIND="false"
EZLYNX_BIND_ENDPOINT=""
EZLYNX_BIND_OPERATION=""
EZLYNX_BIND_SOAP_ACTION=""
CARRIER_BINDING_ENABLE_LIVE_DIRECT="false"

# Transactional email for invoices, e-sign links, signed document copies.
# Recommended: SendGrid if you want to keep email under Twilio, or Resend
# if you install it from Vercel Marketplace.
EMAIL_PROVIDER="sendgrid"
EMAIL_FROM="Quotex Insurance <billing@yourdomain.com>"
SENDGRID_API_KEY=""
RESEND_API_KEY=""

# Twilio SMS for e-sign links, invoice/payment links, and operational notices.
# For U.S. business texting, complete Twilio A2P 10DLC registration before
# production volume. Use either TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
