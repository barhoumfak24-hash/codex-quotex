DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_DOCUMENT_BUCKET="quotex-documents"

JWT_SECRET="replace-with-32-plus-random-characters"
SESSION_SECRET="replace-with-32-plus-random-characters"
JWT_ISSUER="quotex"
JWT_AUDIENCE="quotex-api"
FRONTEND_ORIGIN="http://localhost:5174"
WEBSITE_WEBHOOK_SECRET="replace-with-32-plus-random-characters"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""

# Rate limiting. In production, use a shared store for serverless or
# multi-instance deployments so each instance cannot be bypassed.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_FAIL_OPEN="false"
RATE_LIMIT_APP_PER_MINUTE="900"
RATE_LIMIT_API_PER_MINUTE="300"
RATE_LIMIT_AUTH_PER_MINUTE="30"
RATE_LIMIT_PUBLIC_WORKFLOW_PER_MINUTE="90"
RATE_LIMIT_STRICT_API_PER_MINUTE="20"
RATE_LIMIT_WEBHOOK_PER_MINUTE="120"
RATE_LIMIT_DIAGNOSTICS_PER_MINUTE="20"

# Local development only. Never set true in production.
ALLOW_DEV_AUTH_HEADERS="true"

AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AI_REASONING_MODEL="gpt-5.5"
AI_FAST_MODEL="gpt-5.4-mini"
AI_DOCUMENT_MODEL="gpt-5.5"
AI_AUTOFILL_MODEL="gpt-5.5"
AI_RUNNER_MODEL="gpt-5.5"
AI_PRICING_MODEL="gpt-5.5"
AI_SORT_MODEL="gpt-5.4-mini"
AI_MARKETING_MODEL="gpt-5.4-mini"
AI_PORTAL_ASSISTANT_MODEL="gpt-5.4-mini"
OPENAI_IMAGE_MODEL="gpt-image-2"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
AI_MAX_PAYLOAD_BYTES="2000000"
AI_MAX_REQUESTS_PER_MINUTE="120"
AI_CACHE_TTL_MS="60000"

CARRIER_AUTOMATION_ENABLE_LIVE="false"
CARRIER_AUTOMATION_WORKER_URL=""
CARRIER_AUTOMATION_WORKER_TOKEN=""
CARRIER_AUTOMATION_ALLOWED_HOSTS="foragentsonly.progressive.com,*.chubb.com,*.pureinsurance.com"
CARRIER_AUTOMATION_WORKER_MODE="plan_only"
CARRIER_CREDENTIAL_VAULT_URL=""
CARRIER_CREDENTIAL_VAULT_TOKEN=""
CARRIER_AUTOMATION_ENABLE_AI_PLANNER="false"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

