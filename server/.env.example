TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Backup / disaster recovery runner. Keep these server/operator only.
BACKUP_OUTPUT_DIR="./backups"
BACKUP_RETENTION_DAYS="35"
BACKUP_STORAGE_BUCKETS="quotex-documents"
PGDUMP_PATH="pg_dump"
BACKUP_ALLOW_UNENCRYPTED="false"
BACKUP_ENV_FILE=".env,server/.env"
