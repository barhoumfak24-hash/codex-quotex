{
  "name": "quotex-insurance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:software": "vite --mode software",
    "dev:website": "vite --mode website",
    "dev:app": "vite --mode agency-app",
    "dev:checkout": "vite --mode checkout",
    "build": "tsc -b && vite build",
    "build:software": "tsc -b && vite build --mode software --outDir dist-software",
    "build:website": "tsc -b && vite build --mode website --outDir dist-website",
    "build:app": "tsc -b && vite build --mode agency-app --outDir dist-app",
    "build:checkout": "tsc -b && vite build --mode checkout --outDir dist-checkout",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
