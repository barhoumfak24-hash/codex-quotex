# ===== Frontend (Vite) — only safe values, no secrets =====
VITE_APP_NAME="Quotex Insurance"
VITE_AI_MODE="server"
# Leave blank to use the app default:
# - local Vite dev: /api
# - Vercel production: /api/app/api
# If overriding in Vercel, use /api/app/api, not localhost.
VITE_API_BASE_URL=""
VITE_GOOGLE_CLIENT_ID=""
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"
VITE_SENTRY_RELEASE=""

# Google Places Autocomplete (New) + Place Details + Geocoding API.
# Production address autocomplete uses the server-side proxy routes.
# Configure GOOGLE_PLACES_API_KEY server-side only; do not expose a
# real Google key through a VITE_* frontend environment variable.
# This key reaches the browser (Vite inlines every VITE_* var), so
# restrict it in Cloud Console:
#
#   Application restrictions → HTTP referrers
#     (e.g. https://app.quotexinsurance.com/*, http://localhost:5173/*)
#
#   API restrictions → enable ALL THREE of these for the same key:
#     - Places API (New)        — for autocomplete + place details
#     - Maps JavaScript API     — for the libraries=places SDK loader
#     - Geocoding API           — for property-records address lookup
#
# Having Maps JavaScript API enabled does NOT automatically enable
# Places — they're separate toggles. Without Places API (New), the
# autocomplete dropdown will silently return zero results.
#
# Billing must be active on the Cloud project. The free $200/month
# credit covers normal usage but Places will hard-fail without a
# billing account attached.
#
# The legacy var VITE_GOOGLE_MAPS_API_KEY is still honoured for
# backward compatibility, but new deployments should use the line
# below.
GOOGLE_PLACES_API_KEY=""

# Smarty US Autocomplete Pro — browser embedded key.
# Browser-safe IF you whitelist the deployment domain(s) on the
# "Host" allowlist in Smarty dashboard → Account → Keys → embedded.
# Used by the autocomplete dropdown alongside / instead of Google.
VITE_SMARTY_WEBSITE_KEY=""

# Mapbox token — optional fallback for autocomplete. Browser-safe
# with URL restriction set in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=""

# ===== Server-only secrets (read by Vercel serverless functions
# and the Express server — NEVER prefixed with VITE_ since that
# would inline them into the browser bundle.) =====

# Smarty US Street API secret key pair. Powers /api/smarty-validate,
# which the property-records lookup calls before geocoding to get
# verified deliverable address + ZIP+4 + rooftop lat/lon + county +
# timezone in one round-trip. Conserves the 250-lookup free tier via
# in-memory LRU cache on the function side and sessionStorage cache
# on the browser side. Set these in:
#   - .env (local dev with `vercel dev`)
#   - server/.env (the Express skeleton, if you wire it up)
#   - Vercel Project Settings → Environment Variables (production)
SMARTY_AUTH_ID=""
SMARTY_AUTH_TOKEN=""

# Required to read /api/__diag in production. Use a long random value
# and send it as Authorization: Bearer <token> when troubleshooting.
# Production will fail closed if this is missing or too short.
DIAG_TOKEN=""

# ===== Backend (server/.env and Vercel / hosting env vars) =====
# Supabase Postgres. Use a pooled URL for runtime and a direct URL for
# migrations if your host supports separate values. Never expose either
# value through a VITE_* variable.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_DOCUMENT_BUCKET="quotex-documents"
# JWT_SECRET="replace-with-32-plus-random-characters"
# SESSION_SECRET="replace-with-32-plus-random-characters"
# JWT_ISSUER="quotex"
# JWT_AUDIENCE="quotex-api"
# FRONTEND_ORIGIN="https://app.your-domain.example"
# WEBSITE_WEBHOOK_SECRET="replace-with-32-plus-random-characters"
# ALLOW_DEV_AUTH_HEADERS="false"
# Sentry is required in production so crashes and failed serverless
# execution paths are visible immediately.
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""
#
# # Rate limiting
# # For production/serverless, configure a shared store so every API
# # instance enforces the same client buckets. Production rejects
# # memory-only rate limiting.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# MANAGER_2FA_STORE="postgres"
# RATE_LIMIT_FAIL_OPEN="false"
# RATE_LIMIT_APP_PER_MINUTE="900"
# RATE_LIMIT_API_PER_MINUTE="300"
# RATE_LIMIT_AUTH_PER_MINUTE="30"
# RATE_LIMIT_PUBLIC_WORKFLOW_PER_MINUTE="90"
# RATE_LIMIT_STRICT_API_PER_MINUTE="20"
# RATE_LIMIT_WEBHOOK_PER_MINUTE="120"
# RATE_LIMIT_DIAGNOSTICS_PER_MINUTE="20"
#
# # AI provider - OpenAI only, server side only
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_MAX_REASONING_MODEL="gpt-5"
# AI_REASONING_MODEL="gpt-5"
# AI_FAST_MODEL="gpt-4o-mini"
# AI_DOCUMENT_MODEL="gpt-5"
# AI_AUTOFILL_MODEL="gpt-5"
# AI_RUNNER_MODEL="gpt-5"
# AI_PRICING_MODEL="gpt-5"
# AI_SORT_MODEL="gpt-4o-mini"
# AI_MARKETING_MODEL="gpt-4o-mini"
# AI_PORTAL_ASSISTANT_MODEL="gpt-5"
# OPENAI_IMAGE_MODEL="dall-e-3"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
# AI_MAX_PAYLOAD_BYTES="2000000"
# AI_MAX_REQUESTS_PER_MINUTE="120"
# AI_CACHE_TTL_MS="60000"
#
# # Carrier AI runners - server side only
# # Broker endpoint fails closed until live is explicitly enabled.
# CARRIER_AUTOMATION_ENABLE_LIVE="false"
# # Point this at the protected worker endpoint, for example:
# # https://app.your-domain.example/api/carrier-automation-worker
# CARRIER_AUTOMATION_WORKER_URL=""
# CARRIER_AUTOMATION_WORKER_TOKEN=""
# # Comma/newline/semicolon list. Supports exact hosts and *.domain.com.
# CARRIER_AUTOMATION_ALLOWED_HOSTS="foragentsonly.progressive.com,*.chubb.com,*.pureinsurance.com"
# # plan_only validates and stages the job. playwright runs the protected browser worker.
# CARRIER_AUTOMATION_WORKER_MODE="plan_only"
# Required before CARRIER_AUTOMATION_ENABLE_LIVE=true. The worker
# receives vault references only; raw carrier usernames/passwords must
# never be stored in client state or sent through the browser.
# CARRIER_CREDENTIAL_VAULT_URL=""
# CARRIER_CREDENTIAL_VAULT_TOKEN=""
# CARRIER_AUTOMATION_ENABLE_AI_PLANNER="false"
#
# # Stripe (server side)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
#
# # Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
#
# # SendGrid / SES
# EMAIL_PROVIDER="resend"      # resend | sendgrid | smtp
# SENDGRID_API_KEY=""
# RESEND_API_KEY=""
# EMAIL_FROM="Quotex Insurance <no-reply@your-domain.example>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_REQUIRE_TLS="true"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM_EMAIL="Quotex Insurance <no-reply@your-domain.example>"
# WEBSITE_LEAD_NOTIFY_TO="contact@quotexinsurance.com,support@quotexinsurance.com"
# WEBSITE_SALES_NOTIFY_TO="contact@quotexinsurance.com"
# WEBSITE_SUPPORT_NOTIFY_TO="support@quotexinsurance.com"
# WEBSITE_SALES_EMAIL_FROM="Quotex Insurance <contact@quotexinsurance.com>"
# WEBSITE_SUPPORT_EMAIL_FROM="Quotex Insurance Support <support@quotexinsurance.com>"
# MASTER_PORTAL_EMAIL_FROM="Quotex Insurance <founder@your-domain.example>"
# MASTER_PORTAL_REPLY_TO="founder@your-domain.example"
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
#
# # Staff mailbox OAuth - server side only
# MAILBOX_OAUTH_ENABLED="false"
# MAILBOX_OAUTH_PUBLIC_API_ORIGIN="https://api.your-domain.example"
# MAILBOX_TOKEN_ENCRYPTION_KEY=""
# MAILBOX_TOKEN_KEY_REF="env:MAILBOX_TOKEN_ENCRYPTION_KEY"
# GOOGLE_MAILBOX_CLIENT_ID=""
# GOOGLE_MAILBOX_CLIENT_SECRET=""
# GOOGLE_MAILBOX_REDIRECT_URI=""
# GOOGLE_MAILBOX_SCOPES="openid,email,profile,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.readonly"
# MICROSOFT_MAILBOX_CLIENT_ID=""
# MICROSOFT_MAILBOX_CLIENT_SECRET=""
# MICROSOFT_MAILBOX_TENANT="organizations"
# MICROSOFT_MAILBOX_REDIRECT_URI=""
# MICROSOFT_MAILBOX_SCOPES="openid,profile,email,offline_access,User.Read,Mail.Send,Mail.Read"
#
# # S3 document storage
# S3_BUCKET=""
# S3_REGION=""
#
# # OAuth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ===== Backup / disaster recovery runner (server/operator only) =====
# Use DIRECT_URL for pg_dump when possible. BACKUP_OUTPUT_DIR must point
# to encrypted disk or an encrypted/offsite backup mount in production.
# BACKUP_ALLOW_UNENCRYPTED=true is only for local dry runs.
# CRON_SECRET protects the Vercel daily disaster-recovery check endpoint.
# DR_LIVE_URL and DR_CHECK_TOKEN are optional local operator helpers for
# scripts/dr-live-check.mjs; use DIAG_TOKEN or CRON_SECRET as the token.
# SUPABASE_ACCESS_TOKEN must be a server-only Supabase Management API token
# scoped tightly enough to read project backup and Security Advisor status.
# DR_LAST_RESTORE_DRILL_AT is required in production after a verified restore drill.
# BACKUP_OUTPUT_DIR must be encrypted/offsite for production.
# CRON_SECRET=""
# DR_LIVE_URL="https://quotexinsurance.com"
# DR_CHECK_TOKEN=""
# SUPABASE_PROJECT_REF=""
# SUPABASE_ACCESS_TOKEN=""
# DR_LAST_RESTORE_DRILL_AT=""
# DR_RESTORE_DRILL_MAX_DAYS="90"
# BACKUP_OUTPUT_DIR="./backups"
# BACKUP_OUTPUT_ENCRYPTED="false"
# BACKUP_OFFSITE_TARGET=""
# BACKUP_RETENTION_DAYS="35"
# BACKUP_STORAGE_BUCKETS="quotex-documents"
# PGDUMP_PATH="pg_dump"
# BACKUP_ALLOW_UNENCRYPTED="false"
# BACKUP_ENV_FILE=".env,server/.env"
