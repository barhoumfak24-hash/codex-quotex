{
  "manifest_version": 3,
  "name": "Quotex Connect",
  "version": "0.2.1",
  "description": "One-click carrier portal launcher with local-only encrypted credentials.",
  "action": {
    "default_title": "Quotex Connect",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "*://*.aaa.com/*",
    "*://*.agentcenter.nationwide.com/*",
    "*://*.agentexchange.com/*",
    "*://*.aig.com/*",
    "*://*.allstate.com/*",
    "*://*.amfam.com/*",
    "*://*.amtrustfinancial.com/*",
    "*://*.auto-owners.com/*",
    "*://*.berkleyone.com/*",
    "*://*.chubb.com/*",
    "*://*.cinfin.com/*",
    "*://*.farmers.com/*",
    "*://*.fmic.com/*",
    "*://*.fmins.com/*",
    "*://*.foragentsonly.com/*",
    "*://*.foremoststar.com/*",
    "*://*.grangeinsurance.com/*",
    "*://*.hagertyagent.com/*",
    "*://*.hanover.com/*",
    "*://*.hastingsmutual.com/*",
    "*://*.kemper.com/*",
    "*://*.libertymutual.com/*",
    "*://*.markelamerican.com/*",
    "*://*.meemic.com/*",
    "*://*.mercuryinsurance.com/*",
    "*://*.michfb.com/*",
    "*://*.michiganinsurance.com/*",
    "*://*.natgenagency.com/*",
    "*://*.psmic.com/*",
    "*://*.pureinsurance.com/*",
    "*://*.secura.net/*",
    "*://*.statefarm.com/*",
    "*://*.stillwater.com/*",
    "*://*.thehartford.com/*",
    "*://*.thesilverlining.com/*",
    "*://*.travelers.com/*",
    "*://*.usaa.com/*",
    "*://*.vault.insurance/*",
    "*://*.westfieldinsurance.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aaa.com/*",
        "*://*.agentcenter.nationwide.com/*",
        "*://*.agentexchange.com/*",
        "*://*.aig.com/*",
        "*://*.allstate.com/*",
        "*://*.amfam.com/*",
        "*://*.amtrustfinancial.com/*",
        "*://*.auto-owners.com/*",
        "*://*.berkleyone.com/*",
        "*://*.chubb.com/*",
        "*://*.cinfin.com/*",
        "*://*.farmers.com/*",
        "*://*.fmic.com/*",
        "*://*.fmins.com/*",
        "*://*.foragentsonly.com/*",
        "*://*.foremoststar.com/*",
        "*://*.grangeinsurance.com/*",
        "*://*.hagertyagent.com/*",
        "*://*.hanover.com/*",
        "*://*.hastingsmutual.com/*",
        "*://*.kemper.com/*",
        "*://*.libertymutual.com/*",
        "*://*.markelamerican.com/*",
        "*://*.meemic.com/*",
        "*://*.mercuryinsurance.com/*",
        "*://*.michfb.com/*",
        "*://*.michiganinsurance.com/*",
        "*://*.natgenagency.com/*",
        "*://*.psmic.com/*",
        "*://*.pureinsurance.com/*",
        "*://*.secura.net/*",
        "*://*.statefarm.com/*",
        "*://*.stillwater.com/*",
        "*://*.thehartford.com/*",
        "*://*.thesilverlining.com/*",
        "*://*.travelers.com/*",
        "*://*.usaa.com/*",
        "*://*.vault.insurance/*",
        "*://*.westfieldinsurance.com/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
